  %% ═══════════════════════════════════════════════════════════════
  %% PROJECT B: S3 + P4 (生产部署)
  %% ═══════════════════════════════════════════════════════════════
  
  PB_S3[/"ESP32-S3<br/>控制器<br/><sub>FPGA矩阵→MIDI<br/>路由层</sub>"/]
  PB_Router{{"MIDI 路由<br/><sub>模式选择:</sub><br/><sub>• 直接输出</sub><br/><sub>• 发送 P4</sub><br/><sub>• 混合</sub>"}}
  PB_P4["ESP32-P4<br/>推理器<br/><sub>INT8 LSTM<br/>50-100ms</sub>"]
  PB_Decode["Token 解码<br/><sub>(S3 接收)</sub>"]
  PB_Out[/"合成器输出<br/><sub>USB MIDI</sub>"/]
  
  PB_S3 -->|"USB MIDI"| PB_Router
  PB_Router -->|"UART Token"| PB_P4
  PB_P4 -->|"UART 响应"| PB_Decode
  PB_Decode -->|"MIDI"| PB_Out
  PB_Router -->|"直接路由"| PB_Out
  
  style PB_S3 fill:#2f7d3222,stroke:#2f7d32,stroke-width:2px
