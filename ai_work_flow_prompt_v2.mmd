  %% PROJECT A: S3 + PC (快速原型)
  %% ═══════════════════════════════════════════════════════════════
  
  PA_S3[/"ESP32-S3<br/>MIDI 控制器"/]
  PA_Input["PC 主机<br/><sub>Python<br/>PyTorch + Mido</sub>"]
  PA_PC["实时推理<br/><sub>LSTM 续写<br/>温度、Top-K 调参</sub>"]
  PA_Synth[/"Windows Synth<br/>或 DAW 合成器"/]
  
  PA_S3 -->|"USB MIDI"| PA_Input
  PA_Input -->|"MIDI 事件"| PA_PC
  PA_PC -->|"MIDI + 续写"| PA_Synth
  
  style PA_S3 fill:#1b9aaa22,stroke:#1b9aaa,stroke-width:2px
