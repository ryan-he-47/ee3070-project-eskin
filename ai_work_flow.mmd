flowchart LR
  N10[/"surge xt合成器<br/><sub>合成声音</sub><br/><sub>IN: 虚拟midi端口</sub>"/]
  N4{{"midi_in<br/><sub>接收midi控制器的输入，解析为钢琴卷轴数据帧，每帧包含127个钢琴琴键的压力值。<br/>目前只考虑处理note on/note off<br/><br/>控制功能：通过一个自定义cc消息的值来控制续写模式的开关和模型记忆清除</sub><br/><sub>IN: usb midi输入</sub><br/><sub>OUT: 续写控制信号, 转发原始midi消息, 钢琴卷轴数据帧向量</sub>"}}
  N5[/"esp32-s3 midi控制器<br/><sub>全功能MPE控制器，通过USB-OTG功能输出usb midi信号</sub><br/><sub>OUT: usb</sub>"/]
  N6{{"midi_out<br/><sub>创建一个虚拟midi端口，转发midi消息到surge xt合成器</sub><br/><sub>IN: 续写模式切换, 原始midi消息, 模型续写midi消息</sub><br/><sub>OUT: 虚拟midi端口</sub>"}}
  N7[["自回归续写模型<br/><sub>接收输入张量，自回归续写下一个钢琴卷轴帧，接收到记忆清除指令时清除模型记忆，即对于lstm，重置隐状态，对于transformer，清空上下文嵌入向量</sub><br/><sub>IN: 记忆清除指令, 向量输入</sub><br/><sub>OUT: 预测钢琴卷轴帧向量</sub><br/><sub>MEM: 模型记忆</sub>"]]
  N9["midi解码器<br/><sub>把帧向量解码为midi数据流</sub><br/><sub>IN: 帧向量</sub><br/><sub>OUT: 模型续写midi消息</sub>"]

  %% I/O Connections
  N5 --|"usb -> usb midi输入"|--> N4
  N4 --|"钢琴卷轴数据帧向量 -> 向量输入"|--> N7
  N7 --|"预测钢琴卷轴帧向量 -> 帧向量"|--> N9
  N9 --|"模型续写midi消息 -> 模型续写midi消息"|--> N6
  N4 --|"转发原始midi消息 -> 原始midi消息"|--> N6
  N4 --|"续写控制信号 -> 记忆清除指令"|--> N7
  N4 --|"续写控制信号 -> 续写模式切换"|--> N6
  N6 --|"虚拟midi端口 -> 虚拟midi端口"|--> N10

