flowchart LR
  %% ═══════════════════════════════════════════════════════════════
  %% PROJECT A: S3 + PC (快速原型)
  %% ═══════════════════════════════════════════════════════════════
  
  PA_Input[/"Project A 输入<br/>(ESP32-S3 USB MIDI)"/]
  PA_PC["PC 实时推理<br/><sub>PyTorch LSTM<br/>real_time_inference.py<br/>延迟: 50-150ms</sub>"]
  PA_Synth[/"Windows Synth<br/>合成与播放"/]
  
  PA_Input -->|"USB MIDI"| PA_PC
  PA_PC -->|"MIDI + 续写"| PA_Synth
  
  %% ═══════════════════════════════════════════════════════════════
  %% PROJECT B: S3 + P4 (生产部署)
  %% ═══════════════════════════════════════════════════════════════
  
  N5[/"ESP32-S3<br/>MIDI 控制器<br/><sub>输入层：FPGA矩阵→MIDI</sub><br/><sub>OUT: usb midi</sub>"/]
  N4{{"midi_router<br/><sub>路由决策:</sub><br/><sub>• 直接输出 (USB/BLE)</sub><br/><sub>• 发送 P4 推理</sub><br/><sub>• 混合模式</sub><br/><sub>IN: USB MIDI</sub><br/><sub>OUT: UART Token流 → P4</sub>"}}
  
  PB_P4["ESP32-P4<br/>AI 协处理器<br/><sub>推理层: INT8 LSTM<br/>延迟: 50-100ms</sub>"]
  
  PB_Decode["Token 解码器<br/><sub>(S3 接收)</sub><br/><sub>Token → MIDI</sub>"]
  
  PB_Synth[/"合成器<br/><sub>USB MIDI Out</sub>"/]
  
  N5 -->|"USB MIDI"| N4
  N4 -->|"UART Token (115200)"| PB_P4
  PB_P4 -->|"UART 响应 Token"| PB_Decode
  PB_Decode -->|"MIDI 消息"| PB_Synth
  N4 -->|"直接路由 (USB/BLE)"| PB_Synth
  
  %% ═══════════════════════════════════════════════════════════════
  %% 旧流程（参考）
  %% ═══════════════════════════════════════════════════════════════
  
  N10[/"surge xt<br/>合成器<br/><sub>(参考)</sub>"/]
  N9["midi解码器<br/><sub>把模型输出的事件token解码回 MIDI 消息流。</sub><br/><sub>IN: 事件token</sub><br/><sub>OUT: 模型续写midi消息</sub>"]
  
  N9 -.->|"参考路径"| N10

  %% I/O Connections
  N5 --|"usb -> usb midi输入"|--> N4
  N4 --|"事件token -> 输入token"|--> N7
  N7 --|"预测token -> 事件token"|--> N9
  N9 --|"模型续写midi消息 -> 模型续写midi消息"|--> N6
  N4 --|"转发原始midi消息 -> 原始midi消息"|--> N6
  N4 --|"续写控制信号 -> 记忆清除指令"|--> N7
  N4 --|"续写控制信号 -> 续写模式切换"|--> N6
  N6 --|"虚拟midi端口 -> 虚拟midi端口"|--> N10

  %% Realtime continuation notes
  %% 1) Host side buffers a rolling token context and merges incoming live MIDI with model output.
  %% 2) ESP32-P4 porting should keep the same event vocabulary and timing semantics.
  %% 3) Prompt cleanup / hidden-state reset is the main control knob for phrase boundaries.

  %% Style classes
  classDef cls_program fill:#1b9aaa22,stroke:#1b9aaa,stroke-width:2px;
  classDef cls_module fill:#2f7d3222,stroke:#2f7d32,stroke-width:2px;
  classDef cls_class fill:#3a6ea522,stroke:#3a6ea5,stroke-width:2px;
  classDef cls_struct fill:#6c4ab622,stroke:#6c4ab6,stroke-width:2px;
  classDef cls_function fill:#cf5c3622,stroke:#cf5c36,stroke-width:2px;
  classDef cls_interface fill:#9a031e22,stroke:#9a031e,stroke-width:2px;
  classDef cls_process fill:#7b6d2622,stroke:#7b6d26,stroke-width:2px;
  class N10 cls_module;
  class N4 cls_interface;
  class N5 cls_module;
  class N6 cls_interface;
  class N7 cls_class;
  class N9 cls_function;

